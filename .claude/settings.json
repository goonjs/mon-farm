{
  "permissions": {
    "allow": [
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * --tags*)",
      "Bash(git push --tags*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push * *:*)",
      "Bash(git push * :*)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push -u origin dev*)",
      "Bash(git push -u origin main*)"
    ]
  }
}
