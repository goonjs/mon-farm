rules_version = '2';  // required for the collection-group rule {path=**}

// Server-side group isolation (ACC-5, NFR-5) — docs/architecture.md §Security.
// Deny by default; access follows membership in groups/{gid}/members/{uid}.
// Tests: firestore/rules.test.ts on the emulator (E01-S08).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()     { return request.auth != null; }
    function me()           { return request.auth.uid; }
    function groupDoc(gid)  { return /databases/$(database)/documents/groups/$(gid); }
    function memberDoc(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(me()); }
    function isMember(gid)  { return signedIn() && exists(memberDoc(gid)); }

    // EventEnvelope (architecture §Event envelope) + receivedAt.
    function validEvent(gid, eventId) {
      let e = request.resource.data;
      return e.keys().hasAll(['schema', 'id', 'groupId', 'actor', 'deviceSeq', 'kind', 'targetId',
                              'baseEventId', 'saleId', 'source', 'ts', 'payload', 'receivedAt'])
          && e.keys().hasOnly(['schema', 'id', 'groupId', 'actor', 'deviceSeq', 'kind', 'targetId',
                               'baseEventId', 'alsoBasedOn', 'saleId', 'source', 'ts', 'mono',
                               'payload', 'receivedAt'])
          && e.schema == 1
          && e.id == eventId
          && e.groupId == gid
          && e.actor.keys().hasOnly(['userId', 'deviceId'])
          && e.actor.userId == me()
          && e.receivedAt == request.time;
    }

    match /groups/{gid} {
      allow read:   if isMember(gid);
      allow create: if signedIn() && request.resource.data.createdBy == me()
                    && request.resource.data.memberCount == 1 && existsAfter(memberDoc(gid));
      // Leaving: count drops by exactly one, never below 1, and the leaver's
      // member doc goes in the same batch.
      allow update: if isMember(gid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
                    && resource.data.memberCount > 1
                    && request.resource.data.memberCount == resource.data.memberCount - 1
                    && !existsAfter(memberDoc(gid));
      allow delete: if false;  // MVP never deletes a group

      match /members/{uid} {
        allow read:   if isMember(gid);
        allow get:    if signedIn() && uid == me();  // own doc, also after leaving
        // Only yourself, only in the batch that creates the group; everyone
        // else joins through the acceptInvite function.
        allow create: if signedIn() && uid == me() && !exists(groupDoc(gid))
                      && getAfter(groupDoc(gid)).data.createdBy == me()
                      && request.resource.data.uid == me() && request.resource.data.role == 'owner';
        allow delete: if signedIn() && uid == me()
                      && getAfter(groupDoc(gid)).data.memberCount == get(groupDoc(gid)).data.memberCount - 1;
        allow update: if false;
      }

      // Append-only (SYNC-4). A re-push of an existing id is an update and is
      // refused; the client treats "exists with equal canonical JSON" as sent.
      match /events/{eventId} {
        allow read:   if isMember(gid);
        allow create: if isMember(gid) && validEvent(gid, eventId);
        allow update, delete: if false;
      }
    }

    match /{path=**}/members/{uid} { allow read: if signedIn() && resource.data.uid == me(); }
    match /users/{uid}             { allow read, write: if signedIn() && uid == me(); }
    match /invites/{code}          { allow read, write: if false; }  // Admin SDK in functions only
    match /inviteAttempts/{uid}    { allow read, write: if false; }
  }
}
