{
  "name": "mon-farm",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tokens": "node scripts/emit-tokens.mjs",
    "tokens:check": "node scripts/emit-tokens.mjs --check",
    "contrast": "node scripts/check-contrast.mjs --strict",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:core": "vitest run",
    "test:ui": "jest",
    "build:web": "expo export --platform web --output-dir dist",
    "serve:web": "node scripts/serve-dist.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run tokens:check && npm run contrast && npm run typecheck && npm run lint && npm run test:core && npm run test:ui && npm run build:web && npm run test:e2e",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mon-farm \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.50.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.32.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "basic-ftp": "^6.2.1"
  }
}
